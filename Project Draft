fit1 <- lm(VBR ~ time, TBIlong1)
summary(fit1)

sp1 <-function(x)gsp(x,
                     knots=c(2,3,4,5),
                     degree=c(1,1,1,1),
                     smooth=c(1,1,1,1))

fitsp1 <- lme(VBR~sp1(time),TBIlong1,random=~1|id, 
              na.action = na.omit)

summary(fitsp1)
pred <- data.frame(time = seq(-1, 6, 0.1)) #start, end,incremetents
pred$fitsp1 <- as.numeric(predict(fitsp1,pred,level = 0))


p1 <- xyplot(VBR ~ time, TBIlong1, col = "grey", pch = 16, alpha = 0.5)
p2 <- xyplot(fitsp1 ~ time, data = pred, type = "l", col = "red", lwd = 2)
p1 + p2
