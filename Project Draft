TBI <- read_excel("C:/Users/___/Downloads/TBI.xlsx") #make sure to change this to where it is saved for you
TBIlong <- tolong(TBI, timevar = 'visit' ,idvar = 'SubID')
TBIlong1 <- TBIlong %>%
  mutate(time = as.numeric(sub(".*\\.", "", row.names(.)))
  )
TBIlong1 <- TBIlong1 %>%
  mutate(group = ifelse(grepl("^c", id), "Control", "Patient"))

TBIlong1$group <- factor(TBIlong1$group, levels = c("Patient","Control"))


xyplot( VBR ~ time| visit + sex ,TBIlong1,auto.key = T)

